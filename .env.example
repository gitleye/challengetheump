# ABS Dashboard — environment variables
# Copy to .env and fill in values as needed.
# Currently all data is fetched at build time from public sources.
# No secrets are required for the basic build.

# Optional: set to override the default site URL during local dev
# PUBLIC_SITE_URL=http://localhost:4321

# Optional: GitHub PAT for the data pipeline GitHub Actions workflow
# Only needed in the CI environment (set as a repo secret, not here).
# GH_PAT=ghp_...

# Optional: enable verbose pipeline logging
# PIPELINE_LOG_LEVEL=DEBUG
