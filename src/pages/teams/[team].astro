---
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { TeamsData, TeamRecord } from '@/lib/types';
import { formatRate, formatWpa, formatWinPct } from '@/lib/stats';
import teamsData from '@/data/teams.json';

export async function getStaticPaths() {
  const { teams } = teamsData as unknown as TeamsData;
  return teams.map((team) => ({
    params: { team: team.team_id.toLowerCase() },
    props: { team },
  }));
}

const { team } = Astro.props as { team: TeamRecord };
---

<BaseLayout
  title={team.team_name}
  description={`ABS Challenge System stats for the ${team.team_name}: success rates, WPA, and correlation with win percentage.`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Breadcrumb -->
    <nav class="text-sm text-slate-500 mb-6" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2">
        <li><a href="/teams" class="hover:underline">Teams</a></li>
        <li aria-hidden="true">›</li>
        <li class="text-slate-900 font-medium" aria-current="page">{team.team_name}</li>
      </ol>
    </nav>

    <!-- Team header -->
    <div class="flex items-start justify-between mb-8">
      <div>
        <h1 class="text-3xl font-display font-bold">{team.team_name}</h1>
        <p class="text-slate-500 mt-1">{team.division} · {team.wins}–{team.losses} · {formatWinPct(team.win_pct)}</p>
      </div>
      {team.data_quality !== 'ok' && (
        <span class="bg-yellow-100 text-yellow-800 text-xs font-medium px-2.5 py-1 rounded">
          {team.data_quality === 'stale' ? 'Data may be stale' : 'Partial data'}
        </span>
      )}
    </div>

    <!-- Key stats grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-10">
      <div class="bg-white rounded-lg shadow-sm p-6 text-center">
        <p class="text-3xl font-bold text-brand-navy">{formatWpa(team.challenges.challenge_wpa)}</p>
        <p class="text-sm text-slate-600 mt-1">Challenge WPA</p>
      </div>
      <div class="bg-white rounded-lg shadow-sm p-6 text-center">
        <p class="text-3xl font-bold text-brand-navy">{formatRate(team.challenges.success_rate)}</p>
        <p class="text-sm text-slate-600 mt-1">Success Rate</p>
      </div>
      <div class="bg-white rounded-lg shadow-sm p-6 text-center">
        <p class="text-3xl font-bold text-brand-navy">{team.challenges.total_challenges}</p>
        <p class="text-sm text-slate-600 mt-1">Total Challenges</p>
      </div>
      <div class="bg-white rounded-lg shadow-sm p-6 text-center">
        <p class="text-3xl font-bold text-brand-navy">
          {team.challenges.net_overturns > 0 ? `+${team.challenges.net_overturns}` : team.challenges.net_overturns}
        </p>
        <p class="text-sm text-slate-600 mt-1">Net Overturns</p>
      </div>
    </div>

    <!-- Sample warnings -->
    {team.sample_warnings.length > 0 && (
      <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-8">
        <p class="text-sm font-medium text-yellow-800">Small sample size warnings:</p>
        <ul class="mt-2 space-y-1">
          {team.sample_warnings.map((w) => (
            <li class="text-sm text-yellow-700">• {w.message}</li>
          ))}
        </ul>
      </div>
    )}

    <!-- Chart placeholder (wired up in pages-content prompt) -->
    <div class="bg-white rounded-lg shadow-sm p-8 text-center text-slate-400 border border-dashed border-slate-200">
      <p>Rolling 30-day Challenge WPA chart — coming in the next build phase</p>
    </div>
  </div>
</BaseLayout>
