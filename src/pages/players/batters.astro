---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PlayerTable from '@/components/players/PlayerTable.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import type { PlayersData } from '@/lib/types';
import playersData from '@/data/players.json';

const { players } = playersData as unknown as PlayersData;
const isDataReady = players.length > 0;
const filtered = players.filter((p) => p.challenges.role === 'batter');
---

<BaseLayout
  title="Players — Batters"
  description="Top batters ranked by ABS Challenge volume and success rate."
>
  <section class="border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <h1 class="text-h1 font-display font-bold text-text-primary mb-1">Player Leaderboards</h1>
      <p class="text-body text-text-secondary">Top 50 by challenge volume for each role.</p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    {!isDataReady ? (
      <EmptyState />
    ) : (
      <PlayerTable players={filtered} role="batter" />
    )}
  </div>
</BaseLayout>
