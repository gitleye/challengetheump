---
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { PlayersData, PlayerRecord } from '@/lib/types';
import { formatRate } from '@/lib/stats';
import playersData from '@/data/players.json';

export async function getStaticPaths() {
  const { players } = playersData as unknown as PlayersData;
  return players.map((player) => ({
    params: { player: String(player.player_id) },
    props: { player },
  }));
}

const { player } = Astro.props as { player: PlayerRecord };
---

<BaseLayout
  title={player.name}
  description={`ABS Challenge System stats for ${player.name}: ${player.challenges.total_challenges} challenges, ${(player.challenges.success_rate != null ? (player.challenges.success_rate * 100).toFixed(1) : '—')}% success rate.`}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Breadcrumb -->
    <nav class="text-sm text-slate-500 mb-6" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2">
        <li><a href="/players" class="hover:underline">Players</a></li>
        <li aria-hidden="true">›</li>
        <li class="text-slate-900 font-medium" aria-current="page">{player.name}</li>
      </ol>
    </nav>

    <div class="flex items-start justify-between mb-8">
      <div>
        <h1 class="text-3xl font-display font-bold">{player.name}</h1>
        <p class="text-slate-500 mt-1">{player.position} · {player.team_id}</p>
      </div>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-10">
      <div class="bg-white rounded-lg shadow-sm p-6 text-center">
        <p class="text-3xl font-bold text-brand-navy">{player.challenges.total_challenges}</p>
        <p class="text-sm text-slate-600 mt-1">Challenges</p>
      </div>
      <div class="bg-white rounded-lg shadow-sm p-6 text-center">
        <p class="text-3xl font-bold text-brand-navy">{formatRate(player.challenges.success_rate)}</p>
        <p class="text-sm text-slate-600 mt-1">Success Rate</p>
      </div>
      {player.challenges.role === 'batter' && (
        <>
          <div class="bg-white rounded-lg shadow-sm p-6 text-center">
            <p class="text-3xl font-bold text-brand-navy">{player.challenges.strikeouts_avoided ?? '—'}</p>
            <p class="text-sm text-slate-600 mt-1">K's Avoided</p>
          </div>
          <div class="bg-white rounded-lg shadow-sm p-6 text-center">
            <p class="text-3xl font-bold text-brand-navy">{player.challenges.walks_gained ?? '—'}</p>
            <p class="text-sm text-slate-600 mt-1">Walks Gained</p>
          </div>
        </>
      )}
      {(player.challenges.role === 'catcher' || player.challenges.role === 'pitcher') && (
        <div class="bg-white rounded-lg shadow-sm p-6 text-center">
          <p class="text-3xl font-bold text-brand-navy">{player.challenges.overturns_generated ?? '—'}</p>
          <p class="text-sm text-slate-600 mt-1">Overturns Generated</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
