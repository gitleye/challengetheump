---
import '@/styles/global.css';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import metadata from '@/data/metadata.json';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  noIndex?: boolean;
}

const {
  title,
  description = 'Track MLB ABS Challenge System performance — challenge success rates, net run value, and whether beating the robot umpire actually wins you games.',
  ogImage = '/og-image.png',
  canonicalUrl,
  noIndex = false,
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://challengetheump.com';
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, siteUrl).href;
const fullOgImage = new URL(ogImage, siteUrl).href;
const siteName = 'Challenge The Ump';
const fullTitle = title === 'Home'
  ? `${siteName} — MLB ABS Challenge Analytics`
  : `${title} | ${siteName}`;
---

<!doctype html>
<!--
  ╔═══════════════════════════════════════════════════════╗
  ║  Challenge The Ump — challengetheump.com                    ║
  ║  Built by Leye Oyelami                               ║
  ║                                                      ║
  ║  "The umpire is always right,                        ║
  ║   except when Hawk-Eye disagrees."                   ║
  ║                                                      ║
  ║  Open source: github.com/leyeoyelami/challengetheump   ║
  ╚═══════════════════════════════════════════════════════╝
-->
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0A0A0B" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Challenge The Ump RSS" href="/feed.xml" />

    <!-- Inline theme script — must run before first paint to prevent flash -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = stored === 'light' ? 'light' : stored === 'dark' ? 'dark' : (prefersDark ? 'dark' : 'light');
        document.documentElement.classList.remove('dark', 'light');
        document.documentElement.classList.add(theme);
      })();
    </script>

    <!-- JSON-LD structured data -->
    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Challenge The Ump",
        "url": "https://challengetheump.com",
        "description": "MLB ABS Challenge System analytics dashboard",
        "potentialAction": {
          "@type": "SearchAction",
          "target": "https://challengetheump.com/teams?q={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      }
    </script>
  </head>

  <body class="min-h-screen bg-base text-text-primary flex flex-col font-body">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main-content" class="flex-1 animate-fade-in">
      <slot />
    </main>
    <Footer lastUpdated={metadata.last_updated} season={metadata.season} />
  </body>
</html>
