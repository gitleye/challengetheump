---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import metadata from '@/data/metadata.json';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  noIndex?: boolean;
}

const {
  title,
  description = 'Track MLB ABS Challenge System performance — challenge success rates, net run value, and whether beating the robot umpire actually wins you games.',
  ogImage = '/og-image.png',
  canonicalUrl,
  noIndex = false,
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://challengetheump.com';
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, siteUrl).href;
const fullOgImage = new URL(ogImage, siteUrl).href;
const siteName = 'Challenge The Ump';
const fullTitle = title === 'Home'
  ? `${siteName} — MLB ABS Challenge System Analytics`
  : `${title} | ${siteName}`;
---

<!doctype html>
<!--
  ╔═══════════════════════════════════════════════════════╗
  ║  Challenge The Ump — challengetheump.com                    ║
  ║  Built by a fan                                      ║
  ║                                                      ║
  ║  "The umpire is always right,                        ║
  ║   except when Hawk-Eye disagrees."                   ║
  ║                                                      ║
  ║  Open source: github.com/gitleye/challengetheump      ║
  ╚═══════════════════════════════════════════════════════╝
-->
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0A0A0B" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Challenge The Ump RSS" href="/feed.xml" />
    <ClientRouter fallback="swap" />

    <!-- Inline theme script — must run before first paint to prevent flash -->
    <script is:inline>
      (function () {
        function currentTheme() {
          var stored = null;
          try { stored = localStorage.getItem('theme'); } catch {}
          if (stored === 'light' || stored === 'dark') return stored;
          return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        function apply(root) {
          root.classList.remove('dark', 'light');
          root.classList.add(currentTheme());
        }
        apply(document.documentElement);
        // ClientRouter replaces <html> attributes with the incoming page's, which
        // drops the theme class. Re-apply it to the incoming document before swap.
        document.addEventListener('astro:before-swap', function (e) {
          apply(e.newDocument.documentElement);
        });
      })();
    </script>

    <!-- JSON-LD structured data -->
    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Challenge The Ump",
        "url": "https://challengetheump.com",
        "description": "MLB ABS Challenge System analytics dashboard",
        "potentialAction": {
          "@type": "SearchAction",
          "target": "https://challengetheump.com/teams?q={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      }
    </script>
  </head>

  <body class="min-h-screen bg-base text-text-primary flex flex-col font-body">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main-content" class="flex-1 animate-fade-in">
      <slot />
    </main>
    <Footer lastUpdated={metadata.last_updated} season={metadata.season} />

    <!-- Count-up animation for stat numbers -->
    <script>
      import { initPerPage } from '../lib/page-init';

      initPerPage(() => {
        const els = Array.from(document.querySelectorAll<HTMLElement>('[data-count-up]'));
        const format = (v: number, isInt: boolean, prefix: string, suffix: string) =>
          prefix + (isInt ? Math.round(v).toLocaleString() : v.toFixed(1)) + suffix;

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          els.forEach((el) => {
            const target = parseFloat(el.dataset.countTarget || '0');
            el.textContent = format(target, target % 1 === 0, el.dataset.countPrefix || '', el.dataset.countSuffix || '');
          });
          return;
        }

        let cancelled = false;
        const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              observer.unobserve(entry.target);
              const el = entry.target as HTMLElement;
              const target = parseFloat(el.dataset.countTarget || '0');
              const prefix = el.dataset.countPrefix || '';
              const suffix = el.dataset.countSuffix || '';
              const isInt = target % 1 === 0;
              const duration = 1200;
              const start = performance.now();
              const tick = (now: number) => {
                if (cancelled) return;
                const p = Math.min((now - start) / duration, 1);
                el.textContent = format(ease(p) * target, isInt, prefix, suffix);
                if (p < 1) requestAnimationFrame(tick);
              };
              requestAnimationFrame(tick);
            });
          },
          { threshold: 0.3 },
        );
        els.forEach((el) => observer.observe(el));

        return () => {
          cancelled = true;
          observer.disconnect();
        };
      });
    </script>
  </body>
</html>
