---
/**
 * ABS Challenge System hero visualization.
 * A 3D translucent strike-zone volume standing over home plate, modeled
 * after the MLB broadcast ABS overlay. An ABS result card cycles through
 * ball / strike / overturn calls as pitches arrive.
 */

interface Props {
  successRate?: number;
  class?: string;
}

const { successRate = 0.53, class: cls = '' } = Astro.props;

// ---- Scene projection -----------------------------------------------------
// A lightweight one-point perspective. Ground points (lateral X, depth Z)
// plus a height h project into the 400×440 SVG viewBox. Depth grows away
// from the camera, so farther geometry converges toward the horizon.
const CX = 200;
const HORIZON = 70;
const DEPTH_SCALE = 1380; // ground recession
const LAT_SCALE = 340;    // lateral spread
const RISE_SCALE = 420;   // vertical (height) foreshortening

type Pt = { x: number; y: number };
const r2 = (n: number) => Math.round(n * 100) / 100;

function ground(X: number, Z: number): Pt {
  return { x: r2(CX + (X * LAT_SCALE) / Z), y: r2(HORIZON + DEPTH_SCALE / Z) };
}
function project(X: number, Z: number, h: number): Pt {
  const g = ground(X, Z);
  return { x: g.x, y: r2(g.y - (h * RISE_SCALE) / Z) };
}
const poly = (...ps: Pt[]) => ps.map((p) => `${p.x},${p.y}`).join(' ');

// ---- Strike-zone volume ---------------------------------------------------
// Footprint half-width — shared with home plate so they line up (the real
// strike zone is exactly plate-width).
const PW = 1.05;
const ZW = PW;      // half-width (ground units)
const ZF = 4.55;    // front-face depth
const ZB = 4.95;    // back-face depth
const ZBOT = 0.30;  // bottom height
const ZTOP = 2.45;  // top height

const FBL = project(-ZW, ZF, ZBOT);
const FBR = project( ZW, ZF, ZBOT);
const FTL = project(-ZW, ZF, ZTOP);
const FTR = project( ZW, ZF, ZTOP);
const BBL = project(-ZW, ZB, ZBOT);
const BBR = project( ZW, ZB, ZBOT);
const BTL = project(-ZW, ZB, ZTOP);
const BTR = project( ZW, ZB, ZTOP);

// The front face is axis-aligned in screen space — used as the pitch grid.
const zoneL = FTL.x;
const zoneR = FTR.x;
const zoneT = FTL.y;
const zoneB = FBL.y;
const zoneW = zoneR - zoneL;
const zoneH = zoneB - zoneT;
const zoneCX = zoneL + zoneW / 2;
const zoneCY = zoneT + zoneH / 2;

// ---- Home plate + batter's boxes -----------------------------------------
const plate = poly(
  ground(-PW, 4.78), // back-left
  ground( PW, 4.78), // back-right
  ground( PW, 4.52), // right shoulder
  ground(  0, 4.28), // front point
  ground(-PW, 4.52), // left shoulder
);
const boxL = poly(
  ground(-2.25, 4.00),
  ground(-1.30, 4.00),
  ground(-1.30, 5.60),
  ground(-2.25, 5.60),
);
const boxR = poly(
  ground( 2.25, 4.00),
  ground( 1.30, 4.00),
  ground( 1.30, 5.60),
  ground( 2.25, 5.60),
);
const floorGlow = ground(0, 4.72);

// ---- Pitch sequence -------------------------------------------------------
// Position determines truth (in zone = strike, out = ball). The ump's call
// can differ from truth on borderline pitches. Some bad calls get challenged
// and overturned, some are never challenged.
interface Pitch {
  x: number;        // normalized: zone spans -1..1 on each axis
  y: number;
  truth: 'STRIKE' | 'BALL';
  umpCall: 'STRIKE' | 'BALL';
  challenged: boolean;
  overturned: boolean;
  missedCall: boolean;
}

const pitchDefs: Array<{
  x: number; y: number;
  umpCall: 'STRIKE' | 'BALL';
  challenged: boolean;
}> = [
  // 1. Clear strike, correct call — center of zone
  { x:  0.2,  y: -0.3,  umpCall: 'STRIKE', challenged: false },
  // 2. Clear ball, correct call — way outside
  { x:  1.5,  y:  0.2,  umpCall: 'BALL',   challenged: false },
  // 3. Edge pitch IN zone — ump wrongly calls BALL, never challenged
  { x:  0.85, y: -0.9,  umpCall: 'BALL',   challenged: false },
  // 4. Clear strike, correct call — inside low
  { x: -0.4,  y:  0.5,  umpCall: 'STRIKE', challenged: false },
  // 5. Just outside — ump wrongly calls STRIKE, challenged → overturned to BALL
  { x:  1.1,  y: -0.15, umpCall: 'STRIKE', challenged: true },
  // 6. Clear strike, correct call — dead center
  { x: -0.1,  y:  0.0,  umpCall: 'STRIKE', challenged: false },
  // 7. Edge pitch IN zone — ump wrongly calls BALL, challenged → overturned to STRIKE
  { x: -0.3,  y: -0.95, umpCall: 'BALL',   challenged: true },
  // 8. Clear ball, correct call — low and away
  { x:  0.7,  y:  1.4,  umpCall: 'BALL',   challenged: false },
  // 9. Corner pitch IN zone — ump calls STRIKE, challenged but confirmed
  { x:  0.9,  y:  0.85, umpCall: 'STRIKE', challenged: true },
  // 10. Just outside — ump wrongly calls STRIKE, nobody challenges
  { x: -1.1,  y:  0.6,  umpCall: 'STRIKE', challenged: false },
];

const sequence: Pitch[] = pitchDefs.map((def) => {
  const inZone = Math.abs(def.x) <= 1.0 && Math.abs(def.y) <= 1.0;
  const truth: 'STRIKE' | 'BALL' = inZone ? 'STRIKE' : 'BALL';
  const isBadCall = def.umpCall !== truth;
  return {
    x: def.x,
    y: def.y,
    truth,
    umpCall: def.umpCall,
    challenged: def.challenged,
    overturned: def.challenged && isBadCall,
    missedCall: isBadCall && !def.challenged,
  };
});

// Map each pitch onto the front face of the zone volume.
const svgSequence = sequence.map((p) => ({
  cx: r2(zoneCX + p.x * (zoneW / 2)),
  cy: r2(zoneCY + p.y * (zoneH / 2)),
  ...p,
}));
const sequenceJson = JSON.stringify(svgSequence);
---

<div class:list={['abs-hero', cls]} data-strike-zone>
  <!-- 3D zone SVG -->
  <div class="abs-zone-wrap">
    <svg
      viewBox="0 0 400 440"
      class="abs-zone-svg"
      aria-hidden="true"
      fill="none"
    >
      <defs>
        <filter id="abs-glow" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="3" result="blur" />
          <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
        </filter>
        <filter id="abs-soft" x="-80%" y="-80%" width="260%" height="260%">
          <feGaussianBlur stdDeviation="14" />
        </filter>
        <!-- Front-face glass gradient -->
        <linearGradient id="zone-front" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%"   stop-color="rgba(255,255,255,0.13)" />
          <stop offset="55%"  stop-color="rgba(255,255,255,0.045)" />
          <stop offset="100%" stop-color="rgba(212,255,61,0.08)" />
        </linearGradient>
        <!-- Top-face highlight -->
        <linearGradient id="zone-top" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%"   stop-color="rgba(255,255,255,0.20)" />
          <stop offset="100%" stop-color="rgba(255,255,255,0.10)" />
        </linearGradient>
        <radialGradient id="zone-aura" cx="50%" cy="42%" r="60%">
          <stop offset="0%"   stop-color="rgba(212,255,61,0.16)" />
          <stop offset="100%" stop-color="rgba(212,255,61,0)" />
        </radialGradient>
      </defs>

      <!-- Ambient aura behind the zone -->
      <rect x="60" y="80" width="280" height="320" fill="url(#zone-aura)" />

      <!-- Field — home plate + batter's boxes in perspective -->
      <g class="abs-field">
        <polygon points={boxL} class="abs-chalk-box" />
        <polygon points={boxR} class="abs-chalk-box" />
        <polygon points={plate} class="abs-plate" />
      </g>

      <!-- Floor contact glow under the zone -->
      <ellipse
        cx={floorGlow.x} cy={floorGlow.y} rx="96" ry="16"
        fill="rgba(212,255,61,0.22)" filter="url(#abs-soft)"
      />

      <!-- ===== Strike-zone volume (back to front) ===== -->
      <!-- Back face -->
      <polygon points={poly(BTL, BTR, BBR, BBL)} class="abs-zone-back" />
      <!-- Connecting edges -->
      <line x1={FTL.x} y1={FTL.y} x2={BTL.x} y2={BTL.y} class="abs-zone-edge" />
      <line x1={FTR.x} y1={FTR.y} x2={BTR.x} y2={BTR.y} class="abs-zone-edge" />
      <line x1={FBL.x} y1={FBL.y} x2={BBL.x} y2={BBL.y} class="abs-zone-edge" />
      <line x1={FBR.x} y1={FBR.y} x2={BBR.x} y2={BBR.y} class="abs-zone-edge" />
      <!-- Side faces (thin slivers) -->
      <polygon points={poly(FTL, BTL, BBL, FBL)} class="abs-zone-side" />
      <polygon points={poly(FTR, BTR, BBR, FBR)} class="abs-zone-side" />
      <!-- Top face -->
      <polygon points={poly(BTL, BTR, FTR, FTL)} fill="url(#zone-top)" class="abs-zone-top" />

      <!-- Front face -->
      <rect
        x={zoneL} y={zoneT} width={zoneW} height={zoneH}
        fill="url(#zone-front)"
        class="abs-zone-box"
        rx="1.5"
      />
      <!-- 9-section grid on the front face -->
      <g class="abs-grid">
        <line x1={zoneL} y1={zoneT + zoneH / 3} x2={zoneR} y2={zoneT + zoneH / 3} />
        <line x1={zoneL} y1={zoneT + (2 * zoneH) / 3} x2={zoneR} y2={zoneT + (2 * zoneH) / 3} />
        <line x1={zoneL + zoneW / 3} y1={zoneT} x2={zoneL + zoneW / 3} y2={zoneB} />
        <line x1={zoneL + (2 * zoneW) / 3} y1={zoneT} x2={zoneL + (2 * zoneW) / 3} y2={zoneB} />
      </g>

      <!-- Trail dots (previous pitches, dimmed) -->
      <g id="abs-trail-dots"></g>

      <!-- Impact burst ring -->
      <circle id="abs-impact-ring" cx={zoneCX} cy={zoneCY} r="7" class="abs-impact-ring" />

      <!-- Active pitch dot — positioned by JS -->
      <circle
        id="abs-pitch-dot"
        cx={zoneCX} cy={zoneCY} r="0"
        fill="#ffffff"
        filter="url(#abs-glow)"
        class="abs-pitch-dot"
      />
    </svg>
  </div>

  <!-- ABS overlay card — modeled after broadcast -->
  <div class="abs-card" id="abs-card">
    <div class="abs-card-header">
      <svg class="abs-mlb-logo" viewBox="0 0 26 26" fill="none" aria-hidden="true">
        <circle cx="13" cy="13" r="12" stroke="currentColor" stroke-width="1.2" fill="none"/>
        <path d="M8 18V8h2l3 6 3-6h2v10h-2v-6l-2.5 5h-1L10 12v6H8z" fill="currentColor"/>
      </svg>
      <div class="abs-title">ABS</div>
    </div>
    <div class="abs-card-divider"></div>
    <div class="abs-card-result">
      <span class="abs-call-dot" id="abs-call-dot"></span>
      <span class="abs-call-text" id="abs-call-text">STRIKE</span>
    </div>
    <div class="abs-challenge-line hidden" id="abs-challenge-line">
      <span class="abs-challenge-text" id="abs-challenge-text">CHALLENGED</span>
    </div>
  </div>
</div>

<style>
  .abs-hero {
    position: relative;
    perspective: 1100px;
    transform-style: preserve-3d;
  }

  .abs-zone-wrap {
    transform-style: preserve-3d;
  }

  .abs-zone-svg {
    width: 100%;
    max-height: 380px;
    transform: rotateX(6deg) rotateY(-4deg);
    transition: transform 0.35s ease-out;
    transform-style: preserve-3d;
  }

  @media (max-width: 640px) {
    .abs-zone-svg {
      max-height: 300px;
      transform: rotateX(4deg) rotateY(0deg);
    }
  }

  /* ---- Field ---------------------------------------------------------- */
  .abs-chalk-box {
    fill: rgba(255, 255, 255, 0.015);
    stroke: rgba(255, 255, 255, 0.16);
    stroke-width: 1.25;
    stroke-linejoin: round;
  }
  .abs-plate {
    fill: rgba(255, 255, 255, 0.07);
    stroke: rgba(255, 255, 255, 0.32);
    stroke-width: 1.25;
    stroke-linejoin: round;
  }

  /* ---- Zone volume ---------------------------------------------------- */
  .abs-zone-back {
    fill: rgba(255, 255, 255, 0.012);
    stroke: rgba(255, 255, 255, 0.16);
    stroke-width: 1;
  }
  .abs-zone-edge {
    stroke: rgba(255, 255, 255, 0.28);
    stroke-width: 1;
  }
  .abs-zone-side {
    fill: rgba(255, 255, 255, 0.05);
    stroke: rgba(255, 255, 255, 0.14);
    stroke-width: 0.75;
  }
  .abs-zone-top {
    stroke: rgba(255, 255, 255, 0.4);
    stroke-width: 1;
    stroke-linejoin: round;
  }
  .abs-zone-box {
    stroke: rgba(255, 255, 255, 0.55);
    stroke-width: 1.75;
    animation: abs-zone-glow 4s ease-in-out infinite alternate;
  }
  @keyframes abs-zone-glow {
    0%   { stroke: rgba(255, 255, 255, 0.42); }
    100% { stroke: rgba(212, 255, 61, 0.7); }
  }
  .abs-grid line {
    stroke: rgba(255, 255, 255, 0.13);
    stroke-width: 0.75;
  }

  /* ---- Pitch dot ------------------------------------------------------ */
  .abs-pitch-dot {
    transition: cx 0.16s ease-out, cy 0.16s ease-out;
  }

  .abs-impact-ring {
    fill: none;
    stroke: #fff;
    stroke-width: 1.5;
    opacity: 0;
  }
  .abs-impact-ring.pop {
    animation: abs-ring-pop 0.5s ease-out forwards;
  }
  @keyframes abs-ring-pop {
    0%   { r: 7;  opacity: 0.8; stroke-width: 2; }
    100% { r: 22; opacity: 0;   stroke-width: 0.5; }
  }

  .abs-pitch-dot.impact {
    animation: abs-dot-impact 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }
  @keyframes abs-dot-impact {
    0%   { r: 2;  opacity: 0.6; }
    40%  { r: 12; opacity: 1; }
    70%  { r: 8;  opacity: 1; }
    100% { r: 9;  opacity: 1; }
  }

  /* ---- ABS overlay card ---------------------------------------------- */
  .abs-card {
    position: absolute;
    top: 0;
    right: 0;
    width: 110px;
    background: linear-gradient(135deg, #C8247B, #A01D64);
    border-radius: 8px;
    padding: 10px 12px;
    color: #fff;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    box-shadow: 0 4px 20px rgba(200, 36, 123, 0.35);
    z-index: 10;
    transform: translateZ(20px);
    animation: abs-card-in 0.5s ease-out 0.3s both;
  }

  @media (max-width: 640px) {
    .abs-card {
      width: 90px;
      padding: 8px 10px;
      top: -4px;
      right: -4px;
    }
  }

  .abs-card-header {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 4px;
  }

  .abs-mlb-logo {
    width: 18px;
    height: 18px;
    opacity: 0.9;
  }

  .abs-title {
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .abs-card-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.25);
    margin: 6px 0;
  }

  .abs-card-result {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .abs-call-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #22C55E;
    flex-shrink: 0;
    transition: background 0.2s ease;
  }

  .abs-call-dot.strike { background: #22C55E; }
  .abs-call-dot.ball { background: #FACC15; }
  .abs-call-dot.overturned { background: #D4FF3D; animation: abs-dot-pulse 0.6s ease 2; }

  @keyframes abs-dot-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.4); }
  }

  .abs-call-text {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .abs-challenge-line {
    margin-top: 5px;
    padding-top: 5px;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  .abs-challenge-text {
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  .abs-challenge-line.hidden {
    display: none;
  }

  @keyframes abs-card-in {
    0%   { opacity: 0; transform: translateZ(20px) translateY(-10px) scale(0.95); }
    100% { opacity: 1; transform: translateZ(20px) translateY(0) scale(1); }
  }

  /* ---- Light mode ----------------------------------------------------- */
  :global(html.light) .abs-zone-box {
    stroke: rgba(0, 0, 0, 0.4);
    animation: none;
  }
  :global(html.light) .abs-zone-top { stroke: rgba(0, 0, 0, 0.25); }
  :global(html.light) .abs-zone-edge { stroke: rgba(0, 0, 0, 0.2); }
  :global(html.light) .abs-zone-back { stroke: rgba(0, 0, 0, 0.14); }
  :global(html.light) .abs-zone-side { stroke: rgba(0, 0, 0, 0.1); fill: rgba(0, 0, 0, 0.03); }
  :global(html.light) .abs-grid line { stroke: rgba(0, 0, 0, 0.1); }
  :global(html.light) .abs-chalk-box { stroke: rgba(0, 0, 0, 0.16); }
  :global(html.light) .abs-plate { stroke: rgba(0, 0, 0, 0.28); fill: rgba(0, 0, 0, 0.03); }
  :global(html.light) .abs-pitch-dot { fill: #333; }
  :global(html.light) .abs-card { box-shadow: 0 4px 20px rgba(200, 36, 123, 0.25); }

  /* ---- Reduced motion ------------------------------------------------- */
  @media (prefers-reduced-motion: reduce) {
    .abs-zone-box { animation: none !important; }
    .abs-card { animation: none !important; opacity: 1 !important; }
    .abs-zone-svg { transition: none !important; }
    .abs-pitch-dot { transition: none !important; animation: none !important; }
    .abs-impact-ring { animation: none !important; opacity: 0 !important; }
    .abs-call-dot { animation: none !important; }
  }
</style>

<script is:inline define:vars={{ sequenceJson }}>
(function() {
  var container = document.querySelector('[data-strike-zone]');
  if (!container) return;
  var svg = container.querySelector('.abs-zone-svg');
  var dot = document.getElementById('abs-pitch-dot');
  var ring = document.getElementById('abs-impact-ring');
  var trailGroup = document.getElementById('abs-trail-dots');
  var callDot = document.getElementById('abs-call-dot');
  var callText = document.getElementById('abs-call-text');
  var challengeLine = document.getElementById('abs-challenge-line');
  var challengeText = document.getElementById('abs-challenge-text');
  if (!svg || !dot || !callDot || !callText) return;

  var sequence = JSON.parse(sequenceJson);
  var idx = 0;
  var trails = [];
  var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function showPitch() {
    var p = sequence[idx % sequence.length];

    // Reset dot — start low, toward the camera, below the zone.
    dot.classList.remove('impact');
    dot.setAttribute('r', '0');
    dot.setAttribute('cx', String(200));
    dot.setAttribute('cy', String(425));
    dot.style.opacity = '1';

    // Fly into the front face, then impact.
    setTimeout(function() {
      dot.setAttribute('cx', String(p.cx));
      dot.setAttribute('cy', String(p.cy));

      setTimeout(function() {
        dot.classList.add('impact');

        if (ring) {
          ring.setAttribute('cx', String(p.cx));
          ring.setAttribute('cy', String(p.cy));
          ring.classList.remove('pop');
          void ring.offsetWidth; // force reflow to restart animation
          ring.classList.add('pop');
        }
      }, reducedMotion ? 0 : 120);
    }, reducedMotion ? 0 : 50);

    // Show the ump's call after the ball arrives.
    setTimeout(function() {
      callDot.className = 'abs-call-dot ' + (p.umpCall === 'STRIKE' ? 'strike' : 'ball');
      callText.textContent = p.umpCall;

      if (p.challenged && challengeLine && challengeText) {
        setTimeout(function() {
          challengeLine.classList.remove('hidden');
          challengeText.textContent = 'CHALLENGED';

          setTimeout(function() {
            if (p.overturned) {
              callDot.className = 'abs-call-dot overturned';
              callText.textContent = p.truth;
              challengeText.textContent = 'OVERTURNED';
            } else {
              challengeText.textContent = 'CONFIRMED';
            }
          }, reducedMotion ? 0 : 800);
        }, reducedMotion ? 0 : 600);
      } else if (p.missedCall && challengeLine && challengeText) {
        setTimeout(function() {
          challengeLine.classList.remove('hidden');
          challengeText.textContent = 'NOT CHALLENGED';
        }, reducedMotion ? 0 : 600);
      } else if (challengeLine) {
        challengeLine.classList.add('hidden');
      }
    }, reducedMotion ? 0 : 400);

    // Shrink to a trail dot after a delay.
    setTimeout(function() {
      dot.classList.remove('impact');
      dot.setAttribute('r', '4');
      dot.style.opacity = '0.5';

      // Trail dot color by outcome:
      //   Green  = correct strike call
      //   Yellow = correct ball call
      //   Red    = missed call (bad call, never challenged)
      //   Accent = overturned via challenge
      var trail = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      trail.setAttribute('cx', String(p.cx));
      trail.setAttribute('cy', String(p.cy));
      trail.setAttribute('r', '3');

      var trailColor;
      var trailOpacity = '0.4';
      if (p.challenged && p.overturned) {
        trailColor = '#D4FF3D';
        trailOpacity = '0.6';
      } else if (p.missedCall) {
        trailColor = '#EF4444';
        trailOpacity = '0.5';
      } else if (p.umpCall === 'STRIKE') {
        trailColor = '#22C55E';
      } else {
        trailColor = '#FACC15';
      }

      trail.setAttribute('fill', trailColor);
      trail.setAttribute('opacity', trailOpacity);
      if (trailGroup) trailGroup.appendChild(trail);
      trails.push(trail);

      if (trails.length > 8) {
        var old = trails.shift();
        if (old && old.parentNode) old.parentNode.removeChild(old);
      }
    }, reducedMotion ? 100 : 2800);

    idx++;
  }

  showPitch();
  var interval = reducedMotion ? 3000 : 4000;
  setInterval(showPitch, interval);

  // Parallax — disabled on touch and reduced motion.
  var isTouch = 'ontouchstart' in window;
  if (!isTouch && !reducedMotion) {
    document.addEventListener('mousemove', function(e) {
      var rect = container.getBoundingClientRect();
      var cx = rect.left + rect.width / 2;
      var cy = rect.top + rect.height / 2;
      var dx = (e.clientX - cx) / (rect.width / 2);
      var dy = (e.clientY - cy) / (rect.height / 2);
      var rotY = dx * -4 - 4;
      var rotX = dy * 3 + 6;
      svg.style.transform = 'rotateX(' + rotX + 'deg) rotateY(' + rotY + 'deg)';
    });
  }
})();
</script>
