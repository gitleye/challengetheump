---
interface Props {
  value: string | number;
  label: string;
  delta?: number | null;
  deltaLabel?: string;
  size?: 'xl' | 'lg' | 'md';
  accent?: boolean;
  animate?: boolean;
  class?: string;
}

const {
  value,
  label,
  delta = null,
  deltaLabel,
  size = 'md',
  accent = false,
  animate = false,
  class: cls = '',
} = Astro.props;

const sizeClass = {
  xl: 'text-stat-xl',
  lg: 'text-stat-lg',
  md: 'text-stat',
}[size];

const deltaSign = delta !== null ? (delta > 0 ? '+' : delta < 0 ? '' : '±') : null;
const deltaColor = delta === null ? '' : delta > 0 ? 'text-success' : delta < 0 ? 'text-danger' : 'text-text-tertiary';

// Parse numeric target for animation
const numericValue = typeof value === 'number' ? value : parseFloat(String(value).replace(/[^0-9.\-]/g, ''));
const isNumeric = !isNaN(numericValue) && animate;
const prefix = isNumeric ? String(value).match(/^([^0-9.\-]*)/)?.[1] || '' : '';
const suffix = isNumeric ? String(value).match(/([^0-9.\-]*)$/)?.[1] || '' : '';
---

<div class:list={['flex flex-col gap-1', cls]}>
  <span
    class:list={[
      'font-mono font-bold tabular-nums leading-none',
      sizeClass,
      accent ? 'text-accent' : 'text-text-primary',
    ]}
    aria-label={`${label}: ${value}`}
    data-count-up={isNumeric ? 'true' : undefined}
    data-count-target={isNumeric ? numericValue : undefined}
    data-count-prefix={isNumeric ? prefix : undefined}
    data-count-suffix={isNumeric ? suffix : undefined}
  >
    {isNumeric ? `${prefix}0${suffix}` : value}
  </span>
  <span class="text-caption uppercase tracking-wider text-text-tertiary">{label}</span>
  {delta !== null && (
    <span class:list={['text-body-sm font-medium', deltaColor]} aria-label={deltaLabel}>
      {deltaSign}{typeof delta === 'number' ? (Number.isInteger(delta) ? delta : delta.toFixed(1)) : delta}
      {deltaLabel && <span class="text-text-tertiary ml-1">{deltaLabel}</span>}
    </span>
  )}
</div>
