---
// ThemeToggle — dark/light mode switcher.
// Default: dark. Respects prefers-color-scheme. Persists to localStorage.
---

<button
  type="button"
  data-theme-toggle
  class="theme-toggle-btn w-8 h-8 rounded-md border border-border flex items-center justify-center
    text-text-secondary hover:text-text-primary hover:border-accent
    transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
  aria-label="Toggle color scheme"
>
  <!-- Sun (light mode icon) -->
  <svg class="theme-icon theme-icon-light hidden w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
      d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 8a4 4 0 100 8 4 4 0 000-8z"/>
  </svg>
  <!-- Moon (dark mode icon) -->
  <svg class="theme-icon theme-icon-dark w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
      d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>
  </svg>
</button>

<style>
  .theme-icon {
    transition: opacity 0.25s ease, transform 0.3s ease;
  }
  .theme-icon.hidden {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
    position: absolute;
  }
  .theme-icon:not(.hidden) {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
  .theme-toggle-btn {
    position: relative;
    overflow: hidden;
  }
</style>

<script>
  // The toggle is rendered more than once (desktop + mobile header), so this
  // single bundled script must wire up every instance — no element IDs.
  const html = document.documentElement;
  const toggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const lightIcons = document.querySelectorAll('.theme-icon-light');
  const darkIcons = document.querySelectorAll('.theme-icon-dark');

  function getTheme(): 'dark' | 'light' {
    const stored = localStorage.getItem('theme');
    if (stored === 'dark' || stored === 'light') return stored;
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function applyTheme(theme: 'dark' | 'light') {
    const isLight = theme === 'light';
    html.classList.toggle('light', isLight);
    html.classList.toggle('dark', !isLight);
    lightIcons.forEach((icon) => icon.classList.toggle('hidden', !isLight));
    darkIcons.forEach((icon) => icon.classList.toggle('hidden', isLight));
  }

  applyTheme(getTheme());

  toggles.forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const next = html.classList.contains('light') ? 'dark' : 'light';
      localStorage.setItem('theme', next);

      // Enable smooth transition on all elements
      html.classList.add('theme-transition');
      applyTheme(next);

      // Remove transition class after animation completes to avoid
      // interfering with other transitions (hover effects, etc.)
      setTimeout(() => {
        html.classList.remove('theme-transition');
      }, 450);

      window.dispatchEvent(new CustomEvent('theme-changed', { detail: next }));
    });
  });
</script>
