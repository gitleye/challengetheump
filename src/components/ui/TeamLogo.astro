---
import { teamLogoUrl, teamColor } from '@/lib/team-meta';

interface Props {
  teamId: string;
  size?: number;
  class?: string;
}

const { teamId, size = 24, class: cls = '' } = Astro.props;
const logoUrl = teamLogoUrl(teamId);
const fallbackColor = teamColor(teamId);
---

<span
  class:list={['team-logo-wrap inline-flex items-center justify-center flex-shrink-0 rounded-full overflow-hidden', cls]}
  style={`width:${size}px;height:${size}px;`}
>
  {logoUrl ? (
    <img
      src={logoUrl}
      alt={`${teamId} logo`}
      width={size}
      height={size}
      loading="lazy"
      decoding="async"
      class="team-logo-img object-contain"
      onerror={`this.style.display='none';this.nextElementSibling.style.display='flex';`}
    />
    <span
      class="team-logo-fallback items-center justify-center text-white font-mono font-bold rounded-full"
      style={`display:none;width:${size}px;height:${size}px;font-size:${Math.max(9, size * 0.4)}px;background-color:${fallbackColor};`}
      aria-hidden="true"
    >
      {teamId}
    </span>
  ) : (
    <span
      class="team-logo-fallback flex items-center justify-center text-white font-mono font-bold rounded-full"
      style={`width:${size}px;height:${size}px;font-size:${Math.max(9, size * 0.4)}px;background-color:${fallbackColor};`}
      aria-hidden="true"
    >
      {teamId}
    </span>
  )}
</span>
