---
interface Props {
  title?: string;
  icon?: string;
  cta?: { label: string; href: string };
  class?: string;
  noPadding?: boolean;
}
const { title, icon, cta, class: cls = '', noPadding = false } = Astro.props;
---

<div class:list={[
  'bg-elevated rounded-lg border border-border transition-all duration-200',
  'hover:border-border/80',
  !noPadding && 'p-6',
  cls,
]}>
  {(title || cta) && (
    <div class:list={['flex items-center justify-between', !noPadding ? 'mb-4' : 'px-6 pt-6 mb-4']}>
      {title && (
        <h3 class="text-h3 font-display font-semibold text-text-primary flex items-center gap-2">
          {icon && <span aria-hidden="true">{icon}</span>}
          {title}
        </h3>
      )}
      {cta && (
        <a href={cta.href} class="text-body-sm text-accent hover:underline font-medium">
          {cta.label} →
        </a>
      )}
    </div>
  )}
  <slot />
</div>
