---
interface Dataset {
  label: string;
  data: number[];
  color?: string;
}

interface Props {
  labels: string[];
  datasets: Dataset[];
  title?: string;
  yLabel?: string;
  height?: number;
  class?: string;
  id?: string;
}

const {
  labels,
  datasets,
  title,
  yLabel,
  height = 300,
  class: cls = '',
  id,
} = Astro.props;

const chartId = id || `line-${Math.random().toString(36).slice(2, 8)}`;
const chartData = JSON.stringify({ labels, datasets });
---

<div class:list={['relative', cls]}>
  {title && <p class="text-body-sm font-medium text-text-secondary mb-3">{title}</p>}
  <canvas
    id={chartId}
    height={height}
    aria-label={title || 'Line chart'}
    role="img"
  ></canvas>

  <!-- Accessible fallback table -->
  <details class="mt-2">
    <summary class="text-caption text-text-tertiary cursor-pointer hover:text-text-secondary">
      View as table
    </summary>
    <div class="mt-2 overflow-x-auto">
      <table class="text-body-sm w-full">
        <thead>
          <tr>
            <th class="text-left py-1 px-2 text-text-tertiary">Date</th>
            {datasets.map((ds) => (
              <th class="text-right py-1 px-2 text-text-tertiary">{ds.label}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {labels.map((label, i) => (
            <tr class="border-t border-border/30">
              <td class="py-1 px-2 text-text-secondary">{label}</td>
              {datasets.map((ds) => (
                <td class="py-1 px-2 text-right font-mono text-text-primary">
                  {ds.data[i] !== undefined ? ds.data[i] : '—'}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</div>

<script define:vars={{ chartId, chartData, yLabel }} is:inline>
  (function () {
    window.__lineQueue = window.__lineQueue || [];
    window.__lineQueue.push({ chartId: chartId, chartData: chartData, yLabel: yLabel });
  })();
</script>

<script>
  import Chart from 'chart.js/auto';

  /* eslint-disable @typescript-eslint/no-explicit-any */
  const lineChartInstances: Record<string, any> = {};

  function renderLine(chartId: string, chartData: string, yLabel: string | undefined) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const init = () => {
      const canvas = document.getElementById(chartId);
      if (!canvas || !(canvas instanceof HTMLCanvasElement)) return;

      if (lineChartInstances[chartId]) {
        lineChartInstances[chartId].destroy();
      }

      const parsed = JSON.parse(chartData);
      const isLight = document.documentElement.classList.contains('light');
      const colors = isLight
        ? ['#4A7A00', '#15803D', '#2563EB', '#DB2777', '#EA580C']
        : ['#D4FF3D', '#22C55E', '#60A5FA', '#F472B6', '#FB923C'];
      const gridColor = isLight ? 'rgba(0,0,0,0.06)' : 'rgba(255,255,255,0.06)';
      const labelColor = isLight ? 'rgba(60,60,75,1)' : 'rgba(161,161,170,1)';
      const tooltipBg = isLight ? '#FFFFFF' : '#1C1C20';
      const tooltipBorder = isLight ? '#DCDCE4' : '#2A2A30';
      const tooltipTitle = isLight ? '#0F0F14' : '#F5F5F7';
      const tooltipBody = isLight ? '#3C3C4B' : '#A1A1AA';

      lineChartInstances[chartId] = new Chart(canvas, {
        type: 'line',
        data: {
          labels: parsed.labels,
          datasets: parsed.datasets.map((ds: any, i: number) => ({
            label: ds.label,
            data: ds.data,
            borderColor: ds.color || colors[i % colors.length],
            backgroundColor: 'transparent',
            borderWidth: 2,
            pointRadius: 3,
            pointHoverRadius: 5,
            tension: 0.3,
          })),
        },
        options: {
          responsive: true,
          animation: { duration: 600, easing: 'easeOutQuart' },
          plugins: {
            legend: { labels: { color: labelColor, font: { family: 'Inter', size: 12 } } },
            tooltip: {
              backgroundColor: tooltipBg,
              borderColor: tooltipBorder,
              borderWidth: 1,
              titleColor: tooltipTitle,
              bodyColor: tooltipBody,
              padding: 10,
            },
          },
          scales: {
            x: {
              grid: { color: gridColor },
              ticks: { color: labelColor, font: { family: 'Inter', size: 11 } },
            },
            y: {
              grid: { color: gridColor },
              ticks: { color: labelColor, font: { family: 'JetBrains Mono', size: 11 } },
              ...(yLabel ? { title: { display: true, text: yLabel, color: labelColor } } : {}),
            },
          },
        },
      });
    };

    if ('IntersectionObserver' in window) {
      const obs = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { init(); obs.disconnect(); } });
      }, { threshold: 0.1 });
      const el = document.getElementById(chartId);
      if (el) obs.observe(el);
    } else {
      init();
    }
  }

  const queue = (window as any).__lineQueue || [];
  queue.forEach((item: any) => renderLine(item.chartId, item.chartData, item.yLabel));

  window.addEventListener('theme-changed', () => {
    queue.forEach((item: any) => renderLine(item.chartId, item.chartData, item.yLabel));
  });
</script>
