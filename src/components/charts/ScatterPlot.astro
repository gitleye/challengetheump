---
interface Point {
  x: number;
  y: number;
  label: string;
}

interface Props {
  points: Point[];
  xLabel?: string;
  yLabel?: string;
  title?: string;
  height?: number;
  class?: string;
  id?: string;
}

const {
  points,
  xLabel = 'Challenge Net Run Value',
  yLabel = 'Win %',
  title,
  height = 380,
  class: cls = '',
  id,
} = Astro.props;

const chartId = id || `scatter-${Math.random().toString(36).slice(2, 8)}`;
const chartData = JSON.stringify({ points, xLabel, yLabel });
---

<div class:list={['relative', cls]}>
  {title && <p class="text-body-sm font-medium text-text-secondary mb-3">{title}</p>}
  <div class="relative">
    <canvas id={chartId} height={height} aria-label={title || 'Scatter plot'} role="img"></canvas>
    <button
      id={`${chartId}-clear`}
      class="absolute top-2 right-2 hidden px-2 py-1 rounded text-caption font-medium
        bg-elevated border border-border text-text-secondary hover:text-text-primary
        hover:border-accent/50 transition-colors cursor-pointer"
      type="button"
    >
      Clear selection
    </button>
  </div>

  <details class="mt-2">
    <summary class="text-caption text-text-tertiary cursor-pointer hover:text-text-secondary">
      View as table
    </summary>
    <div class="mt-2 overflow-x-auto">
      <table class="text-body-sm w-full">
        <thead>
          <tr>
            <th class="text-left py-1 px-2 text-text-tertiary">Team</th>
            <th class="text-right py-1 px-2 text-text-tertiary">{xLabel}</th>
            <th class="text-right py-1 px-2 text-text-tertiary">{yLabel}</th>
          </tr>
        </thead>
        <tbody>
          {points.map((p) => (
            <tr class="border-t border-border/30">
              <td class="py-1 px-2 text-text-secondary">{p.label}</td>
              <td class="py-1 px-2 text-right font-mono text-text-primary">{p.x.toFixed(2)}</td>
              <td class="py-1 px-2 text-right font-mono text-text-primary">{p.y.toFixed(3)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</div>

<script define:vars={{ chartId, chartData }} is:inline>
  (function () {
    window.__scatterQueue = window.__scatterQueue || [];
    window.__scatterQueue.push({ chartId: chartId, chartData: chartData });
  })();
</script>

<script>
  import Chart from 'chart.js/auto';

  /* eslint-disable @typescript-eslint/no-explicit-any */
  const chartInstances: Record<string, any> = {};

  // Team full names for tooltips
  const teamNames: Record<string, string> = {
    AZ: 'Arizona Diamondbacks', ATL: 'Atlanta Braves', BAL: 'Baltimore Orioles',
    BOS: 'Boston Red Sox', CHC: 'Chicago Cubs', CWS: 'Chicago White Sox',
    CIN: 'Cincinnati Reds', CLE: 'Cleveland Guardians', COL: 'Colorado Rockies',
    DET: 'Detroit Tigers', HOU: 'Houston Astros', KC: 'Kansas City Royals',
    LAA: 'Los Angeles Angels', LAD: 'Los Angeles Dodgers', MIA: 'Miami Marlins',
    MIL: 'Milwaukee Brewers', MIN: 'Minnesota Twins', NYM: 'New York Mets',
    NYY: 'New York Yankees', ATH: 'Athletics', PHI: 'Philadelphia Phillies',
    PIT: 'Pittsburgh Pirates', SD: 'San Diego Padres', SF: 'San Francisco Giants',
    SEA: 'Seattle Mariners', STL: 'St. Louis Cardinals', TB: 'Tampa Bay Rays',
    TEX: 'Texas Rangers', TOR: 'Toronto Blue Jays', WSH: 'Washington Nationals',
  };

  function renderScatter(chartId: string, chartData: string) {
    const init = () => {
      const canvas = document.getElementById(chartId);
      if (!canvas || !(canvas instanceof HTMLCanvasElement)) return;

      if (chartInstances[chartId]) {
        chartInstances[chartId].destroy();
      }

      const p = JSON.parse(chartData);
      const isLight = document.documentElement.classList.contains('light');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const gridColor = isLight ? 'rgba(0,0,0,0.06)' : 'rgba(255,255,255,0.06)';
      const labelColor = isLight ? 'rgba(60,60,75,1)' : 'rgba(161,161,170,1)';
      const tooltipBg = isLight ? '#FFFFFF' : '#1C1C20';
      const tooltipBorder = isLight ? '#DCDCE4' : '#2A2A30';
      const tooltipTitle = isLight ? '#0F0F14' : '#F5F5F7';
      const tooltipBody = isLight ? '#3C3C4B' : '#A1A1AA';

      const teamColors: Record<string, string> = isLight ? {
        AZ: '#A71930', ATL: '#CE1141', BAL: '#DF4601', BOS: '#BD3039',
        CHC: '#0E3386', CWS: '#27251F', CIN: '#C6011F', CLE: '#00385D',
        COL: '#333366', DET: '#0C2340', HOU: '#002D62', KC: '#004687',
        LAA: '#BA0021', LAD: '#005A9C', MIA: '#00A3E0', MIL: '#C9A200',
        MIN: '#002B5C', NYM: '#002D72', NYY: '#003087', ATH: '#003831',
        PHI: '#E81828', PIT: '#D49B00', SD: '#2F241D', SF: '#FD5A1E',
        SEA: '#0C2C56', STL: '#C41E3A', TB: '#092C5C', TEX: '#003278',
        TOR: '#134A8E', WSH: '#AB0003',
      } : {
        AZ: '#E8365A', ATL: '#F04E6E', BAL: '#FF6B2B', BOS: '#E04850',
        CHC: '#4A7DD4', CWS: '#8A8A8A', CIN: '#EF4444', CLE: '#3B8DD4',
        COL: '#7B7BBF', DET: '#4A80BF', HOU: '#3B7DD9', KC: '#4A8DE0',
        LAA: '#E84050', LAD: '#4A9AE0', MIA: '#40C8F0', MIL: '#FFC52F',
        MIN: '#4A80C8', NYM: '#4A80E0', NYY: '#4A7AD4', ATH: '#2D8B5E',
        PHI: '#F04050', PIT: '#FDB827', SD: '#A08060', SF: '#FF7A40',
        SEA: '#4A80C0', STL: '#E84060', TB: '#4A80D0', TEX: '#4A7ACA',
        TOR: '#4A90D4', WSH: '#E03030',
      };

      // Compute regression line
      const xs = p.points.map((pt: any) => pt.x);
      const ys = p.points.map((pt: any) => pt.y);
      const n = xs.length;
      const mx = xs.reduce((a: number, b: number) => a + b, 0) / n;
      const my = ys.reduce((a: number, b: number) => a + b, 0) / n;
      let num = 0, den = 0;
      for (let i = 0; i < n; i++) { num += (xs[i] - mx) * (ys[i] - my); den += (xs[i] - mx) ** 2; }
      const slope = den !== 0 ? num / den : 0;
      const intercept = my - slope * mx;
      const xMin = Math.min(...xs);
      const xMax = Math.max(...xs);
      const regPoints = [
        { x: xMin, y: slope * xMin + intercept },
        { x: xMax, y: slope * xMax + intercept },
      ];

      // Selection state
      let selectedIndex: number | null = null;
      const clearBtn = document.getElementById(`${chartId}-clear`);

      // Plugin: draw team abbreviation inside each dot
      const teamBadgePlugin = {
        id: 'teamBadge-' + chartId,
        afterDatasetsDraw(chart: any) {
          const ctx = chart.ctx;
          const meta = chart.getDatasetMeta(0);
          ctx.save();
          meta.data.forEach((point: any, i: number) => {
            const { x, y } = point.getProps(['x', 'y']);
            const label = p.points[i]?.label || '';
            const color = teamColors[label] || '#888888';
            const radius = selectedIndex !== null && selectedIndex !== i ? 10 : 14;
            const alpha = selectedIndex !== null && selectedIndex !== i ? 0.25 : 1;

            ctx.globalAlpha = alpha;

            // Draw filled circle badge
            ctx.beginPath();
            ctx.arc(x, y, radius, 0, Math.PI * 2);
            ctx.fillStyle = color + (isLight ? 'DD' : 'BB');
            ctx.fill();
            ctx.strokeStyle = color;
            ctx.lineWidth = 2;
            ctx.stroke();

            // Draw abbreviation text
            ctx.fillStyle = isLight ? '#FFFFFF' : '#FFFFFF';
            ctx.font = `bold ${radius > 10 ? 9 : 7}px 'Inter', sans-serif`;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(label, x, y);

            ctx.globalAlpha = 1;
          });
          ctx.restore();
        },
      };

      // Plugin: regression line with draw animation
      const regressionPlugin = {
        id: 'regression-' + chartId,
        _progress: reducedMotion ? 1 : 0,
        _startTime: 0,
        afterDatasetsDraw(chart: any) {
          const xScale = chart.scales.x;
          const yScale = chart.scales.y;
          const ctx = chart.ctx;
          const self = this as any;

          if (self._progress < 1 && !reducedMotion) {
            if (!self._startTime) self._startTime = Date.now();
            const elapsed = Date.now() - self._startTime;
            self._progress = Math.min(elapsed / 1000, 1);
            if (self._progress < 1) requestAnimationFrame(() => chart.draw());
          }

          const x1 = xScale.getPixelForValue(regPoints[0].x);
          const y1 = yScale.getPixelForValue(regPoints[0].y);
          const x2 = xScale.getPixelForValue(regPoints[1].x);
          const y2 = yScale.getPixelForValue(regPoints[1].y);

          const prog = self._progress;
          const cx = x1 + (x2 - x1) * prog;
          const cy = y1 + (y2 - y1) * prog;

          ctx.save();
          ctx.beginPath();
          ctx.setLineDash([6, 4]);
          ctx.moveTo(x1, y1);
          ctx.lineTo(cx, cy);
          ctx.strokeStyle = isLight ? 'rgba(74,122,0,0.5)' : 'rgba(212,255,61,0.4)';
          ctx.lineWidth = 2;
          ctx.stroke();
          ctx.restore();
        },
      };

      chartInstances[chartId] = new Chart(canvas, {
        type: 'scatter',
        data: {
          datasets: [{
            data: p.points.map((pt: any) => ({ x: pt.x, y: pt.y })),
            backgroundColor: 'transparent',
            borderColor: 'transparent',
            pointRadius: 14,
            pointHoverRadius: 16,
            pointStyle: 'circle',
          }],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: { duration: reducedMotion ? 0 : 600 },
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: tooltipBg,
              borderColor: tooltipBorder,
              borderWidth: 1,
              titleColor: tooltipTitle,
              bodyColor: tooltipBody,
              padding: 12,
              displayColors: false,
              callbacks: {
                title: (items) => {
                  const idx = items[0]?.dataIndex;
                  const abbr = p.points[idx]?.label || '';
                  return teamNames[abbr] || abbr;
                },
                label: (item) => {
                  return [
                    `${p.xLabel}: ${item.parsed.x >= 0 ? '+' : ''}${item.parsed.x.toFixed(2)}`,
                    `${p.yLabel}: ${(item.parsed.y * 100).toFixed(1)}%`,
                  ] as any;
                },
              },
            },
          },
          scales: {
            x: {
              title: { display: true, text: p.xLabel, color: labelColor, font: { size: 11 } },
              grid: { color: gridColor },
              ticks: { color: labelColor, font: { family: 'JetBrains Mono', size: 11 } },
            },
            y: {
              title: { display: true, text: p.yLabel, color: labelColor, font: { size: 11 } },
              grid: { color: gridColor },
              ticks: {
                color: labelColor,
                font: { family: 'JetBrains Mono', size: 11 },
                callback: (v) => `${(Number(v) * 100).toFixed(0)}%`,
              },
            },
          },
          onClick: (_event: any, elements: any[]) => {
            if (elements.length > 0) {
              const idx = elements[0].index;
              selectedIndex = selectedIndex === idx ? null : idx;
            } else {
              selectedIndex = null;
            }
            if (clearBtn) clearBtn.classList.toggle('hidden', selectedIndex === null);
            chartInstances[chartId].draw();
          },
        },
        plugins: [regressionPlugin, teamBadgePlugin],
      });

      // Clear selection button
      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          selectedIndex = null;
          clearBtn.classList.add('hidden');
          chartInstances[chartId].draw();
        });
      }
    };

    if ('IntersectionObserver' in window) {
      const obs = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { init(); obs.disconnect(); } });
      }, { threshold: 0.1 });
      const el = document.getElementById(chartId);
      if (el) obs.observe(el);
    } else {
      init();
    }
  }

  // Process any queued scatter charts
  const queue = (window as any).__scatterQueue || [];
  queue.forEach((item: any) => renderScatter(item.chartId, item.chartData));

  // Re-render all charts when theme changes
  window.addEventListener('theme-changed', () => {
    queue.forEach((item: any) => {
      if (chartInstances[item.chartId]) {
        chartInstances[item.chartId].destroy();
      }
      renderScatter(item.chartId, item.chartData);
    });
  });
</script>
