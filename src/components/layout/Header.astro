---
import ThemeToggle from '@/components/ui/ThemeToggle.astro';
import metadata from '@/data/metadata.json';

const navLinks = [
  { href: '/teams', label: 'Teams' },
  { href: '/players', label: 'Players' },
  { href: '/methodology', label: 'Methodology' },
  { href: '/about', label: 'About' },
];

const currentPath = Astro.url.pathname;

// Freshness badge
const lastUpdated = new Date(metadata.last_updated);
const now = new Date();
const hoursAgo = Math.floor((now.getTime() - lastUpdated.getTime()) / (1000 * 60 * 60));
const freshnessLabel = hoursAgo < 1 ? 'Just updated' : hoursAgo < 24 ? `${hoursAgo}h ago` : `${Math.floor(hoursAgo / 24)}d ago`;
const isFresh = hoursAgo < 24;
---

<header
  class="sticky top-0 z-40 bg-base/90 backdrop-blur-md border-b border-border"
  role="banner"
>
  <nav
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between"
    aria-label="Primary navigation"
  >
    <!-- Wordmark -->
    <a
      href="/"
      class="flex items-center gap-2 group"
      aria-label="Challenge The Ump — Home"
    >
      <svg viewBox="0 0 280 40" fill="none" role="img" aria-label="Challenge The Ump" class="h-7 w-auto">
        <!-- ABS-style strike zone -->
        <rect x="2" y="6" width="22" height="28" rx="1.5" stroke="#D4FF3D" stroke-width="1.8" fill="none" class="logo-zone"/>
        <!-- 9-section grid lines -->
        <line x1="2" y1="15.3" x2="24" y2="15.3" stroke="#D4FF3D" stroke-width="0.5" opacity="0.35"/>
        <line x1="2" y1="24.7" x2="24" y2="24.7" stroke="#D4FF3D" stroke-width="0.5" opacity="0.35"/>
        <line x1="9.3" y1="6" x2="9.3" y2="34" stroke="#D4FF3D" stroke-width="0.5" opacity="0.35"/>
        <line x1="16.7" y1="6" x2="16.7" y2="34" stroke="#D4FF3D" stroke-width="0.5" opacity="0.35"/>
        <!-- Pitch dots -->
        <circle cx="13" cy="20" r="2.5" fill="#22C55E" opacity="0.9"/>
        <circle cx="19" cy="12" r="2" fill="#FACC15" opacity="0.8"/>
        <!-- Wordmark -->
        <text x="34" y="27" font-family="Space Grotesk, system-ui, sans-serif" font-size="18" font-weight="700" letter-spacing="-0.03em" fill="currentColor">
          Challenge <tspan fill="#D4FF3D" class="logo-accent">The Ump</tspan>
        </text>
      </svg>
      <span class="hidden sm:inline-flex items-center gap-1.5 ml-3 px-2 py-0.5 rounded-sm text-[10px] font-medium tracking-wider uppercase text-text-tertiary bg-elevated border border-border">
        <span class:list={['w-1.5 h-1.5 rounded-full', isFresh ? 'bg-success' : 'bg-text-tertiary']}></span>
        {freshnessLabel}
      </span>
    </a>

    <!-- Desktop nav + theme toggle -->
    <div class="hidden md:flex items-center gap-1">
      <ul class="flex items-center gap-1" role="list">
        {navLinks.map(({ href, label }) => {
          const isActive = currentPath.startsWith(href);
          return (
            <li>
              <a
                href={href}
                class:list={[
                  'px-3 py-1.5 rounded-md text-body-sm font-medium transition-colors duration-200',
                  isActive
                    ? 'text-accent bg-accent/10'
                    : 'text-text-secondary hover:text-text-primary hover:bg-elevated',
                ]}
                aria-current={isActive ? 'page' : undefined}
              >
                {label}
              </a>
            </li>
          );
        })}
      </ul>
      <div class="ml-3 pl-3 border-l border-border">
        <ThemeToggle />
      </div>
    </div>

    <!-- Mobile: theme toggle + hamburger -->
    <div class="md:hidden flex items-center gap-2">
      <ThemeToggle />
      <label
        for="mobile-nav-toggle"
        class="w-8 h-8 rounded-md border border-border flex items-center justify-center
          text-text-secondary hover:text-text-primary hover:border-accent cursor-pointer
          transition-colors"
        aria-label="Toggle menu"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </label>
    </div>
  </nav>

  <!-- Mobile menu (CSS-only toggle) -->
  <input type="checkbox" id="mobile-nav-toggle" class="sr-only peer" />
  <div class="hidden peer-checked:block md:hidden border-t border-border bg-base">
    <ul class="px-4 py-3 space-y-1" role="list">
      {navLinks.map(({ href, label }) => {
        const isActive = currentPath.startsWith(href);
        return (
          <li>
            <a
              href={href}
              class:list={[
                'block px-3 py-2 rounded-md text-body-sm font-medium transition-colors',
                isActive
                  ? 'text-accent bg-accent/10'
                  : 'text-text-secondary hover:text-text-primary hover:bg-elevated',
              ]}
              aria-current={isActive ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</header>
