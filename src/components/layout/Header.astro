---
import ThemeToggle from '@/components/ui/ThemeToggle.astro';

const navLinks = [
  { href: '/teams', label: 'Teams' },
  { href: '/players', label: 'Players' },
  { href: '/methodology', label: 'Methodology' },
  { href: '/about', label: 'About' },
];

const currentPath = Astro.url.pathname;
---

<header
  class="sticky top-0 z-40 bg-base/90 backdrop-blur-md border-b border-border"
  role="banner"
>
  <nav
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between"
    aria-label="Primary navigation"
  >
    <!-- Wordmark -->
    <a
      href="/"
      class="flex items-center gap-2 group"
      aria-label="Challenge The Ump — Home"
    >
      <img src="/logo.svg" alt="Challenge The Ump" width="180" height="28" class="h-7 w-auto" />
    </a>

    <!-- Desktop nav + theme toggle -->
    <div class="hidden md:flex items-center gap-1">
      <ul class="flex items-center gap-1" role="list">
        {navLinks.map(({ href, label }) => {
          const isActive = currentPath.startsWith(href);
          return (
            <li>
              <a
                href={href}
                class:list={[
                  'px-3 py-1.5 rounded-md text-body-sm font-medium transition-colors duration-200',
                  isActive
                    ? 'text-accent bg-accent/10'
                    : 'text-text-secondary hover:text-text-primary hover:bg-elevated',
                ]}
                aria-current={isActive ? 'page' : undefined}
              >
                {label}
              </a>
            </li>
          );
        })}
      </ul>
      <div class="ml-3 pl-3 border-l border-border">
        <ThemeToggle />
      </div>
    </div>

    <!-- Mobile: theme toggle + hamburger -->
    <div class="md:hidden flex items-center gap-2">
      <ThemeToggle />
      <label
        for="mobile-nav-toggle"
        class="w-8 h-8 rounded-md border border-border flex items-center justify-center
          text-text-secondary hover:text-text-primary hover:border-accent cursor-pointer
          transition-colors"
        aria-label="Toggle menu"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </label>
    </div>
  </nav>

  <!-- Mobile menu (CSS-only toggle) -->
  <input type="checkbox" id="mobile-nav-toggle" class="sr-only peer" />
  <div class="hidden peer-checked:block md:hidden border-t border-border bg-base">
    <ul class="px-4 py-3 space-y-1" role="list">
      {navLinks.map(({ href, label }) => {
        const isActive = currentPath.startsWith(href);
        return (
          <li>
            <a
              href={href}
              class:list={[
                'block px-3 py-2 rounded-md text-body-sm font-medium transition-colors',
                isActive
                  ? 'text-accent bg-accent/10'
                  : 'text-text-secondary hover:text-text-primary hover:bg-elevated',
              ]}
              aria-current={isActive ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</header>
