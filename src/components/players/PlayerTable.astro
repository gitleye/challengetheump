---
import Card from '@/components/ui/Card.astro';
import Tooltip from '@/components/ui/Tooltip.astro';
import PlayerAvatar from '@/components/ui/PlayerAvatar.astro';
import type { PlayerRecord, PlayerRole } from '@/lib/types';
import { formatRate } from '@/lib/stats';

interface Props {
  players: PlayerRecord[];
  role: PlayerRole;
}

const { players, role } = Astro.props;
const display = players.slice(0, 50);

const roleLabels: Record<string, string> = {
  batter: 'Batters',
  catcher: 'Catchers',
};

const roles: PlayerRole[] = ['batter', 'catcher'];
const roleHrefs: Record<string, string> = {
  batter: '/players/batters',
  catcher: '/players',
};
---

<!-- Role tabs ------------------------------------------------------------- -->
<nav class="flex gap-2 mb-8" aria-label="Player role filter">
  {roles.map((r) => (
    <a
      href={roleHrefs[r]}
      class:list={[
        'px-4 py-2 rounded-md text-body-sm font-medium transition-colors duration-200',
        role === r
          ? 'bg-accent text-black font-semibold'
          : 'bg-elevated border border-border text-text-secondary hover:text-text-primary hover:border-accent/50',
      ]}
      aria-current={role === r ? 'page' : undefined}
    >
      {roleLabels[r]}
    </a>
  ))}
</nav>

{display.length === 0 ? (
  <div class="rounded-lg border border-border p-12 text-center">
    <p class="text-text-tertiary text-body">No data available for this role yet.</p>
  </div>
) : (
  <Card noPadding>
    <div class="overflow-x-auto">
      <table class="data-table w-full">
        <thead>
          <tr>
            <th class="w-12">#</th>
            <th class="w-auto">Player</th>
            <th class="w-16">Team</th>
            <th class="text-right w-32 whitespace-nowrap">
              <Tooltip text="Total challenges made this season.">Challenges</Tooltip>
            </th>
            <th class="text-right w-32 whitespace-nowrap">
              <Tooltip text="Percentage of challenges resulting in an overturn.">Success%</Tooltip>
            </th>
            {role === 'batter' && (
              <>
                <th class="text-right w-36 whitespace-nowrap hidden sm:table-cell">
                  <Tooltip text="Strikeouts converted to balls via successful challenge.">Ks Avoided</Tooltip>
                </th>
                <th class="text-right w-36 whitespace-nowrap hidden sm:table-cell">
                  <Tooltip text="Balls converted to walks via successful challenge.">BB Gained</Tooltip>
                </th>
              </>
            )}
            {role === 'catcher' && (
              <th class="text-right w-36 whitespace-nowrap hidden sm:table-cell">
                <Tooltip text="Overturns where the catcher initiated the challenge.">OT Generated</Tooltip>
              </th>
            )}
          </tr>
        </thead>
        <tbody>
          {display.map((player, i) => (
            <tr>
              <td class="text-text-tertiary font-mono">{i + 1}</td>
              <td>
                <div class="flex items-center gap-2">
                  <PlayerAvatar playerId={player.player_id} name={player.name} teamId={player.team_id} size={28} />
                  <a
                    href={`/players/${player.player_id}`}
                    class="font-medium text-text-primary hover:text-accent transition-colors"
                  >
                    {player.name}
                  </a>
                </div>
              </td>
              <td class="font-mono text-text-secondary">{player.team_id}</td>
              <td class="text-right font-mono">{player.challenges.total_challenges}</td>
              <td class="text-right font-mono text-accent font-bold">
                {formatRate(player.challenges.success_rate)}
              </td>
              {role === 'batter' && (
                <>
                  <td class="text-right font-mono text-text-secondary hidden sm:table-cell">
                    {player.challenges.strikeouts_avoided ?? '—'}
                  </td>
                  <td class="text-right font-mono text-text-secondary hidden sm:table-cell">
                    {player.challenges.walks_gained ?? '—'}
                  </td>
                </>
              )}
              {role === 'catcher' && (
                <td class="text-right font-mono text-text-secondary hidden sm:table-cell">
                  {player.challenges.overturns_generated ?? '—'}
                </td>
              )}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {players.length > 50 && (
      <div class="px-6 py-4 border-t border-border text-body-sm text-text-tertiary">
        Showing top 50 of {players.length} players.
      </div>
    )}
  </Card>
)}
