      "postcss": ">=8.5.23",
      "nanoid": ">=3.3.18",
      "svgo": ">=4.1.0",
      "smol-toml": ">=1.9.0",
      "devalue": ">=5.9.3",
      "source-map-js": ">=1.2.2",
      "postcss-selector-parser": ">=7.1.6"
